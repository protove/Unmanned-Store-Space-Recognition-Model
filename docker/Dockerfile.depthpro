# ────────────────────────────────────────────────────────────────────────────
# Stage 1 – DepthPro inference service
#
# Reads  : /data/input/          (원본 이미지)
# Reads  : /data/checkpoints/    (depth_pro.pt)
# Writes : /data/depth_maps/     (depth NPY + PNG + meta TXT)
# ────────────────────────────────────────────────────────────────────────────
FROM nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# ── 시스템 패키지 ──────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.10 python3.10-dev python3-pip \
        wget curl \
    && rm -rf /var/lib/apt/lists/* \
    && update-alternatives --install /usr/bin/python python /usr/bin/python3.10 1 \
    && update-alternatives --install /usr/bin/pip    pip    /usr/bin/pip3    1

# ── PyTorch (CUDA 11.8) ────────────────────────────────────────────────────
RUN pip install --index-url https://download.pytorch.org/whl/cu118 \
        torch>=2.0.0 \
        torchvision>=0.15.0

# ── DepthPro 패키지 설치 ───────────────────────────────────────────────────
COPY depth_pro/ml-depth-pro/ /app/ml-depth-pro/
RUN pip install -e /app/ml-depth-pro/

# ── 추가 의존성 ────────────────────────────────────────────────────────────
RUN pip install \
        "numpy<2.0.0" \
        tqdm \
        matplotlib \
        pillow \
        pillow-heif

# ── 실행 스크립트 복사 ─────────────────────────────────────────────────────
COPY depth_pro/ml-depth-pro/depth_pro_batch.py /app/

WORKDIR /app

# 기본 명령: 입력/출력/체크포인트 경로는 docker-compose 또는 CLI에서 덮어씀
ENTRYPOINT ["python", "depth_pro_batch.py"]
CMD ["--input",      "/data/input", \
     "--output",     "/data/depth_maps", \
     "--checkpoint", "/data/checkpoints/depth_pro.pt"]
